# Evolution API (WhatsApp) — coleta Locgram
EVOLUTION_API_URL=http://127.0.0.1:8080
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=

# Grupo/chat do Locgram Atendimento (jid). Vazio = aceita qualquer chat
# que parecer "Nova ocorrência" + placa.
EVOLUTION_JID_LOCGRAM=

# Webhook local que a Evolution chama
LOCGRAM_WEBHOOK_PORT=8790

# Opcional: se a Evolution mandar apikey no header
LOCGRAM_WEBHOOK_SECRET=
