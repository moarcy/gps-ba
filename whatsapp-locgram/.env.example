# Evolution API (WhatsApp) — coleta Locgram
# Neste PC a porta 8080 costuma ser o Telegram Radar. Coloque a porta real da Evolution.
EVOLUTION_API_URL=http://127.0.0.1:8081
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=

# Se a Evolution está em Docker no mesmo PC:
# EVOLUTION_WEBHOOK_URL=http://host.docker.internal:8790/webhook
EVOLUTION_WEBHOOK_URL=http://127.0.0.1:8790/webhook

# Grupo/chat do Locgram Atendimento (jid). Rode: npm run chats
EVOLUTION_JID_LOCGRAM=

# Porta do worker neste PC
LOCGRAM_WEBHOOK_PORT=8790

# Opcional: se a Evolution mandar apikey no header
LOCGRAM_WEBHOOK_SECRET=
