# Google Drive / planilhas
SPREADSHEET_ID_1=
SPREADSHEET_ID_2=

# Service account (JSON inteiro em uma linha) — use na Vercel
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# Local (arquivo)
# GOOGLE_CREDENTIALS_FILE=credentials.json

DASHBOARD_API_PORT=8787

# Webhook iLoc (POST /api/webhooks/iloc)
# Token que você cola em «Novo webhook». Segredo HMAC que o iLoc mostra no fim do cadastro.
# ILOC_WEBHOOK_TOKEN=
# ILOC_WEBHOOK_SEGREDO=
# Pasta do Drive onde cada evento vira um JSON. Obrigatória na Vercel.
# ILOC_LOG_FOLDER_ID=

# NFS-e — worker Playwright (portal Camaçari)
# NFSE_WORKER_URL=http://127.0.0.1:8791
# NFSE_WORKER_SECRET=troque-este-segredo
# NFSE_WORKER_TIMEOUT_MS=180000
