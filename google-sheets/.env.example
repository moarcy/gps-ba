# ID da planilha (parte da URL: .../d/ESTE_ID/edit)
SPREADSHEET_ID=
SPREADSHEET_ID_1=
SPREADSHEET_ID_2=

# Caminho para o JSON da conta de serviço (baixado do Google Cloud)
GOOGLE_CREDENTIALS_FILE=credentials.json

# Nome da aba (opcional; usa a primeira aba se vazio)
SHEET_NAME=

DASHBOARD_API_PORT=8787

# Webhook iLoc — o mesmo par cadastrado em «Novo webhook»
# ILOC_WEBHOOK_TOKEN=
# ILOC_WEBHOOK_SEGREDO=
# ILOC_LOG_FOLDER_ID=

# Pasta no Drive com a foto escolhida de cada placa (index.json + jpg).
# BIRA_FOTOS_FOLDER_ID=

# NFS-e worker (Playwright / portal Camaçari)
# NFSE_WORKER_URL=http://127.0.0.1:8791
# NFSE_WORKER_SECRET=troque-este-segredo
# NFSE_WORKER_TIMEOUT_MS=180000

# Certificado A1 da GPS BAHIA (e-CNPJ 10.348.519/0001-19).
# O arquivo .pfx fica só neste PC (já ignorado pelo git). A senha fica no .env do worker.
# NFSE_CERT_PATH=certs/gps-bahia.pfx
# NFSE_CERT_PASSWORD=
