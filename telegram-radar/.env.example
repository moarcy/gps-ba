# Bot Telegram (@BotFather)
TELEGRAM_BOT_TOKEN=

# Para onde o bot manda os alertas filtrados.
# Vazio: usa o chat de quem mandar /start no privado.
TELEGRAM_DEST_CHAT_ID=

# GO no Telegram: só Feira de Santana. Rotas de outras câmeras entram no histórico
# se a placa já passou na praça.
RADAR_KEYWORDS=FEIRA DE SANTANA
# Quantas mensagens ler no import:history (mais = mais rotas)
RADAR_HISTORY_LIMIT=15000
# Ao ligar o PC: avisar Feira atrasado se tiver no máximo N horas
RADAR_CATCHUP_NOTIFY_HOURS=18
# Poll de segurança enquanto o notebook está ligado (ms)
RADAR_POLL_MS=30000
# Quantas mensagens puxar no catch-up
RADAR_CATCHUP_LIMIT=4000

# --- Obrigatório para ler o grupo da blacklist (outro bot) ---
# https://my.telegram.org → API development tools
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE=55
TELEGRAM_SESSION=

# ID do grupo/canal de origem. Rode: npm run chats
TELEGRAM_SOURCE_CHAT_ID=
