# Bot Telegram (@BotFather)
TELEGRAM_BOT_TOKEN=

# Para onde o bot manda os alertas filtrados.
# Vazio: usa o chat de quem mandar /start no privado.
TELEGRAM_DEST_CHAT_ID=

# Palavras que passam no filtro (OR). Padrão: ENDRIGO, FEIRA DE SANTANA
RADAR_KEYWORDS=ENDRIGO,FEIRA DE SANTANA

# --- Obrigatório para ler o grupo da blacklist (outro bot) ---
# https://my.telegram.org → API development tools
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE=55
TELEGRAM_SESSION=

# ID do grupo/canal de origem. Rode: npm run chats
TELEGRAM_SOURCE_CHAT_ID=
